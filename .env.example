DATABASE_URL="postgresql://bruker:passord@localhost:5432/vedlikehold?schema=public"
AUTH_SECRET="generer-med-openssl-rand-base64-32"
ANTHROPIC_API_KEY=""

# E-post til leverandører (valgfritt).
# Uten disse fungerer bestillinger fortsatt: systemet lager e-posten ferdig,
# og du sender den fra din egen e-postklient.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Vedlikehold <ordre@firma.no>"

# Registrering av nye bedrifter styres ikke herfra.
# /registrer er åpen kun mens databasen er tom, slik at plattformeieren kan
# opprette seg selv. Deretter oppretter plattformeieren kundene fra /plattform.

# Passord for testbrukerne som «npm run db:seed» oppretter.
# Står den tom brukes «passord123», som er kjent for alle som har lest koden.
SEED_PASSWORD=""

# Kun i produksjon: direkte tilkobling utenom tilkoblingspoolen.
# Migrasjoner trenger låser som en pool i transaksjonsmodus ikke slipper
# gjennom. Neon og Supabase gir deg begge strengene — den «unpooled» hører
# hjemme her. Lokalt lar du den stå tom.
DIRECT_DATABASE_URL=""
