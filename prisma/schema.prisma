// Vedlikeholdssystem (CMMS) — datamodell
//
// Flerklient (multi-tenant): alle forretningstabeller har organizationId.
// All datatilgang går gjennom src/lib/tenant.ts som tvinger dette filteret på.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────
// Organisasjon og brukere
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  /// Brukes i URL og som kundeidentifikator
  slug      String   @unique
  name      String
  orgNumber String?
  /// Standard timepris brukt når bruker mangler egen sats
  hourlyRate Decimal @default(950) @db.Decimal(10, 2)
  currency  String   @default("NOK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  assets        Asset[]
  workOrders    WorkOrder[]
  parts         Part[]
  suppliers     Supplier[]
  pmPlans       PmPlan[]
  costCenters   CostCenter[]
  budgets       Budget[]
  dashboards    Dashboard[]
  conversations Conversation[]
  timeEntries   TimeEntry[]
  partUsages    PartUsage[]
  stockMoves    StockMovement[]
  comments      Comment[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
  counters      Counter[]

  @@map("organizations")
}

enum Role {
  ADMIN // full tilgang, kan administrere brukere
  LEDER // ser alt, godkjenner, eier budsjett
  PLANLEGGER // planlegger arbeid og forebyggende vedlikehold
  TEKNIKER // utfører arbeid, fører timer og deleuttak
  GJEST // kun lesetilgang
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  name           String
  passwordHash   String
  role           Role     @default(TEKNIKER)
  /// Timepris for kostnadsberegning. Null = bruk organisasjonens sats.
  hourlyRate     Decimal? @db.Decimal(10, 2)
  phone          String?
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedOrders   WorkOrder[]    @relation("Melder")
  assignedOrders    WorkOrder[]    @relation("Tildelt")
  pmPlans           PmPlan[]
  timeEntries       TimeEntry[]
  stockMoves        StockMovement[]
  comments          Comment[]
  attachments       Attachment[]
  dashboards        Dashboard[]
  conversations     Conversation[]
  auditLogs         AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Anleggsstruktur — ett selvrefererende tre
// Anlegg → System → Utstyr → Komponent
// ─────────────────────────────────────────────────────────────

enum AssetType {
  ANLEGG
  SYSTEM
  UTSTYR
  KOMPONENT
}

enum AssetStatus {
  I_DRIFT
  STANSET
  UNDER_VEDLIKEHOLD
  UTRANGERT
}

model Asset {
  id             String      @id @default(cuid())
  organizationId String
  parentId       String?
  /// Materialisert sti ("/rot/barn/barnebarn") for raske deltre-spørringer
  path           String      @default("")
  /// Antall nivåer under rot, 0 = anlegg
  depth          Int         @default(0)
  type           AssetType   @default(UTSTYR)
  /// Menneskelesbar TAG, f.eks. "P-101". Unik per organisasjon.
  code           String
  name           String
  description    String?
  status         AssetStatus @default(I_DRIFT)
  /// 1 = ubetydelig, 5 = kritisk for produksjon. Styrer prioritering.
  criticality    Int         @default(3)

  manufacturer   String?
  modelNumber    String?
  serialNumber   String?
  location       String?
  installedAt    DateTime?
  warrantyUntil  DateTime?
  purchaseCost   Decimal?    @db.Decimal(12, 2)
  /// Driftstimer, brukes av forebyggende planer med timeintervall
  runningHours   Float       @default(0)

  costCenterId   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Asset?       @relation("AssetTre", fields: [parentId], references: [id], onDelete: Restrict)
  children     Asset[]      @relation("AssetTre")
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  workOrders  WorkOrder[]
  pmPlans     PmPlan[]
  parts       AssetPart[]
  attachments Attachment[]
  budgets     Budget[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@index([organizationId, path])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "assets_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "assets_code_trgm_idx")
  @@map("assets")
}

// ─────────────────────────────────────────────────────────────
// Arbeidsordre
// ─────────────────────────────────────────────────────────────

enum WorkOrderType {
  KORREKTIV // retter en oppstått feil
  FOREBYGGENDE // generert fra PM-plan
  INSPEKSJON
  FORBEDRING
}

enum WorkOrderStatus {
  MELDT // registrert, ikke behandlet
  GODKJENT
  PLANLAGT // lagt inn i ukeplan
  PAAGAAR
  VENTER_DELER
  UTFORT // arbeid ferdig, ikke gjennomgått
  LUKKET // gjennomgått og avsluttet
  AVVIST
}

enum Priority {
  KRITISK // produksjonsstopp, haster
  HOY
  NORMAL
  LAV
}

model WorkOrder {
  id             String          @id @default(cuid())
  organizationId String
  /// Løpenummer per organisasjon, vises som AO-1042
  number         Int
  title          String
  description    String?
  type           WorkOrderType   @default(KORREKTIV)
  status         WorkOrderStatus @default(MELDT)
  priority       Priority        @default(NORMAL)

  assetId        String?
  requestedById  String
  assignedToId   String?
  pmPlanId       String?

  /// Fritekst: hva som faktisk løste problemet. Viktigste feltet for AI-søket.
  resolution     String?
  /// Kort kode for feiltype, brukes i statistikk (f.eks. "LAGERSKADE")
  failureCode    String?
  /// Minutter produksjonen sto stille som følge av feilen
  downtimeMinutes Int?

  estimatedHours Float?
  dueDate        DateTime?
  /// Dato jobben er lagt på i ukeplanen
  plannedDate    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Vedlikeholdes av Postgres (GENERATED ALWAYS) — se migrasjonen fulltekstsok.
  /// Prisma leser den ikke, men må kjenne til den for å ikke melde falsk drift.
  searchVector Unsupported("tsvector")? @map("search_vector")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  requestedBy  User         @relation("Melder", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo   User?        @relation("Tildelt", fields: [assignedToId], references: [id], onDelete: SetNull)
  pmPlan       PmPlan?      @relation(fields: [pmPlanId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]
  partUsages  PartUsage[]
  comments    Comment[]
  attachments Attachment[]
  stockMoves  StockMovement[]
  checklist   ChecklistItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId, plannedDate])
  @@index([organizationId, assetId])
  @@index([searchVector], type: Gin, map: "work_orders_search_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "work_orders_title_trgm_idx")
  @@map("work_orders")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  workOrderId String
  sortOrder   Int       @default(0)
  text        String
  isDone      Boolean   @default(false)
  doneAt      DateTime?
  note        String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("checklist_items")
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String
  userId         String
  workedOn       DateTime @db.Date
  hours          Float
  /// Sats kopieres inn ved registrering slik at historiske kostnader ikke endrer seg
  hourlyRate     Decimal  @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@index([organizationId, userId, workedOn])
  @@map("time_entries")
}

// ─────────────────────────────────────────────────────────────
// Reservedeler og lager
// ─────────────────────────────────────────────────────────────

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parts        Part[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("suppliers")
}

model Part {
  id                String   @id @default(cuid())
  organizationId    String
  /// Internt delenummer, unikt per organisasjon
  number            String
  name              String
  description       String?
  manufacturer      String?
  manufacturerPartNo String?
  unit              String   @default("stk")
  unitCost          Decimal  @default(0) @db.Decimal(12, 2)
  /// Beholdning holdes oppdatert i samme transaksjon som lagerbevegelsene
  quantityOnHand    Float    @default(0)
  minStock          Float    @default(0)
  maxStock          Float?
  /// Fysisk lagerplass, f.eks. "Hylle B3"
  binLocation       String?
  supplierId        String?
  leadTimeDays      Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  usages    PartUsage[]
  movements StockMovement[]
  assets    AssetPart[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "parts_name_trgm_idx")
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "parts_number_trgm_idx")
  @@map("parts")
}

/// Kobling mellom utstyr og delene det bruker — gjør at teknikeren
/// ser "hvilke deler passer denne maskinen" rett fra utstyrskortet.
model AssetPart {
  id       String @id @default(cuid())
  assetId  String
  partId   String
  /// Hvor mange av delen som sitter i utstyret
  quantity Float  @default(1)
  note     String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([assetId, partId])
  @@index([partId])
  @@map("asset_parts")
}

model PartUsage {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String
  partId         String
  quantity       Float
  /// Kopiert kostnad på uttakstidspunktet
  unitCost       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@index([partId])
  @@map("part_usages")
}

enum StockMovementType {
  INN // mottak fra leverandør
  UT // uttak til arbeidsordre
  JUSTERING // opptelling / korreksjon
}

/// Reskontro over alle lagerendringer. Beholdningen på Part skal alltid
/// være lik summen av quantity her.
model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  partId         String
  type           StockMovementType
  /// Positiv ved innkjøp, negativ ved uttak
  quantity       Float
  unitCost       Decimal?          @db.Decimal(12, 2)
  workOrderId    String?
  userId         String?
  note           String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, partId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// Forebyggende vedlikehold
// ─────────────────────────────────────────────────────────────

enum PmTrigger {
  TID // fast intervall i dager
  DRIFTSTIMER // basert på Asset.runningHours
}

model PmPlan {
  id             String    @id @default(cuid())
  organizationId String
  assetId        String
  name           String
  description    String?
  trigger        PmTrigger @default(TID)
  /// Antall dager mellom hver gang, brukes når trigger = TID
  intervalDays   Int?
  /// Antall driftstimer mellom hver gang, brukes når trigger = DRIFTSTIMER
  intervalHours  Float?
  /// Hvor mange dager før forfall arbeidsordren skal opprettes
  leadTimeDays   Int       @default(7)
  estimatedHours Float?
  priority       Priority  @default(NORMAL)
  assignedToId   String?
  /// Punktene teknikeren skal krysse av, kopieres til hver arbeidsordre
  checklist      Json      @default("[]")
  lastDoneAt     DateTime?
  nextDueAt      DateTime?
  /// Driftstimestand ved forrige utførelse
  lastDoneHours  Float?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  workOrders   WorkOrder[]

  @@index([organizationId, nextDueAt])
  @@index([organizationId, assetId])
  @@map("pm_plans")
}

// ─────────────────────────────────────────────────────────────
// Kostnadssteder og budsjett
// ─────────────────────────────────────────────────────────────

model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  budgets      Budget[]

  @@unique([organizationId, code])
  @@map("cost_centers")
}

enum BudgetCategory {
  ARBEID
  DELER
  TJENESTER
  TOTALT
}

model Budget {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  year           Int
  /// 1–12 for månedsbudsjett, null for helårsbudsjett
  month          Int?
  category       BudgetCategory @default(TOTALT)
  amount         Decimal        @db.Decimal(14, 2)
  costCenterId   String?
  /// Budsjett kan alternativt knyttes direkte til et anlegg
  assetId        String?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, year])
  @@map("budgets")
}

// ─────────────────────────────────────────────────────────────
// Dashbord — oppsettet lagres som JSON slik at brukeren
// fritt kan legge til, fjerne og flytte widgets.
// ─────────────────────────────────────────────────────────────

model Dashboard {
  id             String   @id @default(cuid())
  organizationId String
  /// Null = delt dashbord for hele organisasjonen
  userId         String?
  name           String
  isDefault      Boolean  @default(false)
  /// [{ id, type, w, config }] — se src/lib/dashboard/widgets.ts
  layout         Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("dashboards")
}

// ─────────────────────────────────────────────────────────────
// Chatbot
// ─────────────────────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @default("Ny samtale")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([organizationId, userId, updatedAt])
  @@map("conversations")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  /// Arbeidsordre og kilder svaret bygger på, vises som klikkbare referanser
  citations      Json     @default("[]")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────────────────────
// Felles
// ─────────────────────────────────────────────────────────────

model Comment {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String
  userId         String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, workOrderId, createdAt])
  @@map("comments")
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String?
  assetId        String?
  uploadedById   String?
  fileName       String
  /// Sti under /uploads
  storagePath    String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, workOrderId])
  @@index([organizationId, assetId])
  @@map("attachments")
}

/// Løpenummer per organisasjon. Oppdateres med en atomisk UPDATE ... RETURNING
/// slik at to samtidige arbeidsordrer aldri får samme nummer.
model Counter {
  organizationId String
  name           String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, name])
  @@map("counters")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  changes        Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
