// Vedlikeholdssystem (CMMS) — datamodell
//
// Flerklient (multi-tenant): alle forretningstabeller har organizationId.
// All datatilgang går gjennom src/lib/tenant.ts som tvinger dette filteret på.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────
// Organisasjon og brukere
// ─────────────────────────────────────────────────────────────

model Organization {
  id          String  @id @default(cuid())
  /// Brukes i URL og som kundeidentifikator
  slug        String  @unique
  name        String
  orgNumber   String?
  /// Deaktivert bedrift beholder alle data, men ingen kommer inn.
  isActive    Boolean @default(true)
  /// Hva hver rolle får se, endre og administrere. Null = standardoppsettet
  /// i src/lib/rettigheter.ts. Se der for formatet.
  permissions Json?
  /// Hva kunden betaler for
  plan        Plan    @default(BASIS)
  /// Enkeltfunksjoner slått av eller på for denne kunden, uavhengig av planen.
  /// Formatet står i src/lib/planer.ts.
  features    Json?
  /// Standard timepris brukt når bruker mangler egen sats
  hourlyRate  Decimal @default(950) @db.Decimal(10, 2)
  currency    String  @default("NOK")

  /// Kontaktopplysninger. Brukes som avsender og leveringsadresse i
  /// bestillinger som sendes til leverandør.
  email      String?
  phone      String?
  address    String?
  postalCode String?
  city       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  assets         Asset[]
  workOrders     WorkOrder[]
  parts          Part[]
  suppliers      Supplier[]
  pmPlans        PmPlan[]
  costCenters    CostCenter[]
  budgets        Budget[]
  dashboards     Dashboard[]
  conversations  Conversation[]
  timeEntries    TimeEntry[]
  partUsages     PartUsage[]
  stockMoves     StockMovement[]
  comments       Comment[]
  attachments    Attachment[]
  auditLogs      AuditLog[]
  counters       Counter[]
  purchaseOrders PurchaseOrder[]
  failureCauses  FailureCause[]
  listValues     ListValue[]
  deviations     Deviation[]

  @@map("organizations")
}

/**
 * Årsakene et firma kan velge mellom når en feil skal forklares.
 * Lista styres av administrator under Oppsett, fordi hva som er en nyttig
 * årsak varierer helt med hva slags anlegg man drifter.
 * Arbeidsordren lagrer koden, ikke en peker hit. Det er med vilje: fjerner
 * noen en årsak fra lista, skal historikken fortsatt vise hva feilen ble
 * kalt den gangen.
 */
model FailureCause {
  id             String  @id @default(cuid())
  organizationId String
  /// Kort kode som lagres på arbeidsordren, f.eks. LAGERSKADE
  code           String
  name           String
  description    String?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("failure_causes")
}

/**
 * Hva kunden betaler for.
 * Planen er utgangspunktet, ikke fasiten. En kunde kan få én enkelt funksjon
 * slått på uten å bytte plan — det er ofte slik en oppgradering begynner, og
 * det skal ikke kreve at noen skriver om koden.
 */
enum Plan {
  BASIS
  PLUSS
  PRO
}

enum Role {
  ADMIN // full tilgang, kan administrere brukere
  LEDER // ser alt, godkjenner, eier budsjett
  PLANLEGGER // planlegger arbeid og forebyggende vedlikehold
  DELELAGER // styrer reservedeler, bestillinger og leverandører
  TEKNIKER // utfører arbeid, fører timer og deleuttak
  GJEST // kun lesetilgang
}

model User {
  id                String    @id @default(cuid())
  organizationId    String
  email             String
  name              String
  passwordHash      String
  role              Role      @default(TEKNIKER)
  /// Timepris for kostnadsberegning. Null = bruk organisasjonens sats.
  hourlyRate        Decimal?  @db.Decimal(10, 2)
  phone             String?
  isActive          Boolean   @default(true)
  /// Plattformeier: kan opprette bedrifter og bytte mellom dem.
  isSuperAdmin      Boolean   @default(false)
  /// Innlogginger utstedt før dette tidspunktet er ugyldige. Settes ved
  /// passordbytte, slik at gamle økter kastes ut med det samme.
  sessionsValidFrom DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedOrders    WorkOrder[]      @relation("Melder")
  assignedOrders     WorkOrder[]      @relation("Tildelt")
  purchaseOrders     PurchaseOrder[]
  pmPlans            PmPlan[]
  timeEntries        TimeEntry[]
  stockMoves         StockMovement[]
  comments           Comment[]
  attachments        Attachment[]
  dashboards         Dashboard[]
  conversations      Conversation[]
  auditLogs          AuditLog[]
  dashboardShares    DashboardShare[]
  passwordResets     PasswordReset[]
  reportedDeviations Deviation[]      @relation("AvvikMelder")
  assignedDeviations Deviation[]      @relation("AvvikAnsvarlig")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Anleggsstruktur — ett selvrefererende tre
// Anlegg → System → Utstyr → Komponent
// ─────────────────────────────────────────────────────────────

enum AssetType {
  ANLEGG
  SYSTEM
  UTSTYR
  KOMPONENT
}

enum AssetStatus {
  I_DRIFT
  STANSET
  UNDER_VEDLIKEHOLD
  UTRANGERT
}

model Asset {
  id             String      @id @default(cuid())
  organizationId String
  parentId       String?
  /// Materialisert sti ("/rot/barn/barnebarn") for raske deltre-spørringer
  path           String      @default("")
  /// Antall nivåer under rot, 0 = anlegg
  depth          Int         @default(0)
  type           AssetType   @default(UTSTYR)
  /// Menneskelesbar TAG, f.eks. "P-101". Unik per organisasjon.
  code           String
  name           String
  description    String?
  status         AssetStatus @default(I_DRIFT)
  /// 1 = ubetydelig, 5 = kritisk for produksjon. Styrer prioritering.
  criticality    Int         @default(3)

  manufacturer  String?
  modelNumber   String?
  serialNumber  String?
  location      String?
  installedAt   DateTime?
  warrantyUntil DateTime?
  purchaseCost  Decimal?  @db.Decimal(12, 2)
  /// Driftstimer, brukes av forebyggende planer med timeintervall
  runningHours  Float     @default(0)

  costCenterId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Asset?       @relation("AssetTre", fields: [parentId], references: [id], onDelete: Restrict)
  children     Asset[]      @relation("AssetTre")
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  workOrders  WorkOrder[]
  pmPlans     PmPlan[]
  deviations  Deviation[]
  parts       AssetPart[]
  attachments Attachment[]
  budgets     Budget[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@index([organizationId, path])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "assets_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "assets_code_trgm_idx")
  @@map("assets")
}

// ─────────────────────────────────────────────────────────────
// Arbeidsordre
// ─────────────────────────────────────────────────────────────

/**
 * Verdier i en liste firmaet styrer selv.
 * Arbeidsordretypen var en enum med fire faste verdier. Det holder til det
 * første firmaet og ikke det andre: noen skiller mellom garanti og
 * ombygging, andre vil ha «tredjepart» eller «myndighetspålagt». Å legge til
 * en verdi skal ikke kreve at noen skriver om koden.
 * «list» sier hvilken liste verdien hører til. Da kan flere lister komme til
 * senere uten en ny tabell for hver.
 * Koden er det som lagres på arbeidsordren, og kan ikke endres etterpå — da
 * ville gammel historikk plutselig betydd noe annet. Navnet kan endres fritt.
 */
model ListValue {
  id             String  @id @default(cuid())
  organizationId String
  /// Hvilken liste, f.eks. "ordretype"
  list           String
  /// Kort kode som lagres på raden
  code           String
  name           String
  description    String?
  /// Fargetone på etiketten. Se TONER i src/lib/lister.ts.
  tone           String  @default("noytral")
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)
  /// Innebygde verdier kan ikke slettes — systemet bruker dem selv
  isBuiltIn      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, list, code])
  @@index([organizationId, list])
  @@map("list_values")
}

enum WorkOrderStatus {
  MELDT // registrert, ikke behandlet
  GODKJENT
  PLANLAGT // lagt inn i ukeplan
  PAAGAAR
  VENTER_DELER
  UTFORT // arbeid ferdig, ikke gjennomgått
  LUKKET // gjennomgått og avsluttet
  AVVIST
}

enum Priority {
  KRITISK // produksjonsstopp, haster
  HOY
  NORMAL
  LAV
}

model WorkOrder {
  id             String          @id @default(cuid())
  organizationId String
  /// Løpenummer per organisasjon, vises som AO-1042
  number         Int
  title          String
  description    String?
  /// Kode fra lista «ordretype». Se src/lib/lister.ts.
  type           String          @default("KORREKTIV")
  status         WorkOrderStatus @default(MELDT)
  priority       Priority        @default(NORMAL)

  assetId       String?
  requestedById String
  assignedToId  String?
  pmPlanId      String?

  /// Fritekst: hva som faktisk løste problemet. Viktigste feltet for AI-søket.
  resolution      String?
  /// Kort kode for feiltype, brukes i statistikk (f.eks. "LAGERSKADE")
  failureCode     String?
  /// Minutter produksjonen sto stille som følge av feilen
  downtimeMinutes Int?

  estimatedHours Float?
  dueDate        DateTime?
  /// Dato jobben er lagt på i ukeplanen
  plannedDate    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Vedlikeholdes av Postgres (GENERATED ALWAYS) — se migrasjonen fulltekstsok.
  /// Prisma leser den ikke, men må kjenne til den for å ikke melde falsk drift.
  searchVector Unsupported("tsvector")? @map("search_vector")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  requestedBy  User         @relation("Melder", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo   User?        @relation("Tildelt", fields: [assignedToId], references: [id], onDelete: SetNull)
  pmPlan       PmPlan?      @relation(fields: [pmPlanId], references: [id], onDelete: SetNull)

  timeEntries TimeEntry[]
  partUsages  PartUsage[]
  comments    Comment[]
  attachments Attachment[]
  stockMoves  StockMovement[]
  checklist   ChecklistItem[]
  deviations  Deviation[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId, plannedDate])
  @@index([organizationId, assetId])
  @@index([searchVector], type: Gin, map: "work_orders_search_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "work_orders_title_trgm_idx")
  @@map("work_orders")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  workOrderId String
  sortOrder   Int       @default(0)
  text        String
  isDone      Boolean   @default(false)
  doneAt      DateTime?
  note        String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("checklist_items")
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String
  userId         String
  workedOn       DateTime @db.Date
  hours          Float
  /// Sats kopieres inn ved registrering slik at historiske kostnader ikke endrer seg
  hourlyRate     Decimal  @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@index([organizationId, userId, workedOn])
  @@map("time_entries")
}

// ─────────────────────────────────────────────────────────────
// Reservedeler og lager
// ─────────────────────────────────────────────────────────────

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parts          Part[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("suppliers")
}

model Part {
  id                 String   @id @default(cuid())
  organizationId     String
  /// Internt delenummer, unikt per organisasjon
  number             String
  name               String
  description        String?
  manufacturer       String?
  manufacturerPartNo String?
  unit               String   @default("stk")
  unitCost           Decimal  @default(0) @db.Decimal(12, 2)
  /// Beholdning holdes oppdatert i samme transaksjon som lagerbevegelsene
  quantityOnHand     Float    @default(0)
  minStock           Float    @default(0)
  maxStock           Float?
  /// Fysisk lagerplass, f.eks. "Hylle B3"
  binLocation        String?
  supplierId         String?
  leadTimeDays       Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  usages        PartUsage[]
  movements     StockMovement[]
  assets        AssetPart[]
  purchaseLines PurchaseOrderLine[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "parts_name_trgm_idx")
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "parts_number_trgm_idx")
  @@map("parts")
}

/// Kobling mellom utstyr og delene det bruker — gjør at teknikeren
/// ser "hvilke deler passer denne maskinen" rett fra utstyrskortet.
model AssetPart {
  id       String  @id @default(cuid())
  assetId  String
  partId   String
  /// Hvor mange av delen som sitter i utstyret
  quantity Float   @default(1)
  note     String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([assetId, partId])
  @@index([partId])
  @@map("asset_parts")
}

model PartUsage {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String
  partId         String
  quantity       Float
  /// Kopiert kostnad på uttakstidspunktet
  unitCost       Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@index([partId])
  @@map("part_usages")
}

enum StockMovementType {
  INN // mottak fra leverandør
  UT // uttak til arbeidsordre
  JUSTERING // opptelling / korreksjon
}

/// Reskontro over alle lagerendringer. Beholdningen på Part skal alltid
/// være lik summen av quantity her.
model StockMovement {
  id              String            @id @default(cuid())
  organizationId  String
  partId          String
  type            StockMovementType
  /// Positiv ved innkjøp, negativ ved uttak
  quantity        Float
  unitCost        Decimal?          @db.Decimal(12, 2)
  workOrderId     String?
  /// Satt når bevegelsen kom av at en bestilling ble mottatt
  purchaseOrderId String?
  userId          String?
  note            String?
  createdAt       DateTime          @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part          Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, partId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// Bestillinger til leverandør
// ─────────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  UTKAST // laget, men ikke sendt
  SENDT
  DELVIS_MOTTATT
  MOTTATT
  KANSELLERT
}

/// En bestilling går alltid til én leverandør. Skal flere leverandører
/// leveres deler samtidig, lages det én bestilling per leverandør — det er
/// slik en innkjøper faktisk jobber, og slik leverandøren vil ha det.
model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  /// Løpenummer per organisasjon, vises som BE-0042
  number         Int
  supplierId     String
  status         PurchaseOrderStatus @default(UTKAST)
  createdById    String

  /// Deres referanse eller rekvisisjonsnummer hos leverandøren
  reference  String?
  note       String?
  expectedAt DateTime?

  /// Adressen bestillingen faktisk ble sendt til, lagret som dokumentasjon
  sentToEmail String?
  /// "smtp" når systemet sendte den selv, "manuell" når brukeren sendte
  /// den fra sin egen e-postklient
  sentMethod  String?
  sentAt      DateTime?
  receivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  movements    StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  partId           String
  quantity         Float
  /// Pris kopieres inn ved bestilling, så senere prisendringer ikke
  /// omskriver hva denne bestillingen kostet
  unitCost         Decimal @db.Decimal(12, 2)
  /// Hvor mye som faktisk er mottatt. Delleveranser er normalt.
  receivedQuantity Float   @default(0)
  note             String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, partId])
  @@index([partId])
  @@map("purchase_order_lines")
}

// ─────────────────────────────────────────────────────────────
// Forebyggende vedlikehold
// ─────────────────────────────────────────────────────────────

enum PmTrigger {
  TID // fast intervall i dager
  DRIFTSTIMER // basert på Asset.runningHours
}

model PmPlan {
  id             String    @id @default(cuid())
  organizationId String
  assetId        String
  name           String
  description    String?
  trigger        PmTrigger @default(TID)
  /// Antall dager mellom hver gang, brukes når trigger = TID
  intervalDays   Int?
  /// Antall driftstimer mellom hver gang, brukes når trigger = DRIFTSTIMER
  intervalHours  Float?
  /// Hvor mange dager før forfall arbeidsordren skal opprettes
  leadTimeDays   Int       @default(7)
  estimatedHours Float?
  priority       Priority  @default(NORMAL)
  assignedToId   String?
  /// Punktene teknikeren skal krysse av, kopieres til hver arbeidsordre
  checklist      Json      @default("[]")
  lastDoneAt     DateTime?
  nextDueAt      DateTime?
  /// Driftstimestand ved forrige utførelse
  lastDoneHours  Float?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  workOrders   WorkOrder[]

  @@index([organizationId, nextDueAt])
  @@index([organizationId, assetId])
  @@map("pm_plans")
}

// ─────────────────────────────────────────────────────────────
// Kostnadssteder og budsjett
// ─────────────────────────────────────────────────────────────

model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  budgets      Budget[]

  @@unique([organizationId, code])
  @@map("cost_centers")
}

enum BudgetCategory {
  ARBEID
  DELER
  TJENESTER
  TOTALT
}

model Budget {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  year           Int
  /// 1–12 for månedsbudsjett, null for helårsbudsjett
  month          Int?
  category       BudgetCategory @default(TOTALT)
  amount         Decimal        @db.Decimal(14, 2)
  costCenterId   String?
  /// Budsjett kan alternativt knyttes direkte til et anlegg
  assetId        String?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, year])
  @@map("budgets")
}

// ─────────────────────────────────────────────────────────────
// Dashbord — oppsettet lagres som JSON slik at brukeren
// fritt kan legge til, fjerne og flytte widgets.
// ─────────────────────────────────────────────────────────────

/**
 * Én person deler dashbordoppsettet sitt med en kollega, eller med alle.
 * Tabellen har ingen organizationId. Den arver tilhørigheten fra dashbordet,
 * og alle oppslag går derfor gjennom dashboards — se kommentaren i
 * src/lib/tenant.ts om tabeller som arver.
 */
model DashboardShare {
  id          String   @id @default(cuid())
  dashboardId String
  /// Null betyr delt med hele bedriften
  userId      String?
  createdAt   DateTime @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([userId])
  @@map("dashboard_shares")
}

/**
 * Engangslenke for å sette nytt passord.
 * Selve tokenet lagres aldri — bare en hash av det. Kommer noen seg til
 * databasen, får de en liste med hasher de ikke kan gjøre noe med, i stedet
 * for nøkler til hver eneste konto.
 * Tabellen arver tilhørighet fra brukeren. Oppslagene skjer med vilje uten
 * flerklient-filteret: den som har glemt passordet er ikke logget inn, og vi
 * vet ikke hvilken bedrift hen tilhører før tokenet er slått opp.
 */
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────────
// Avvik — HMS, nestenulykker, kvalitet og miljø
// ─────────────────────────────────────────────────────────────

enum DeviationType {
  HMS // helse, miljø og sikkerhet
  NAERULYKKE // gikk bra denne gangen
  KVALITET
  MILJO
  ANNET
}

enum DeviationSeverity {
  LAV
  MIDDELS
  HOY
  KRITISK
}

enum DeviationStatus {
  MELDT
  UNDER_BEHANDLING
  TILTAK_IVERKSATT
  LUKKET
  AVVIST
}

/**
 * Et avvik: noe som gikk galt, eller nesten gikk galt.
 * Dette er ikke det samme som en arbeidsordre. En arbeidsordre er en jobb som
 * skal gjøres; et avvik er en hendelse som skal forklares og forebygges. De
 * henger ofte sammen — en lekkasje meldes som avvik og fører til en jobb — og
 * derfor kan avviket peke på arbeidsordren som ble opprettet for å rette det.
 * Feltene følger den rekkefølgen en avviksbehandling faktisk går i:
 * hva skjedde, hva gjorde vi der og da, hvorfor skjedde det, og hva gjør vi
 * for at det ikke skal skje igjen. Uten det siste er avviksregistrering bare
 * en logg over ting som gikk galt.
 */
model Deviation {
  id             String            @id @default(cuid())
  organizationId String
  /// Løpenummer per organisasjon, vises som AV-0042
  number         Int
  title          String
  description    String
  type           DeviationType     @default(HMS)
  severity       DeviationSeverity @default(MIDDELS)
  status         DeviationStatus   @default(MELDT)

  assetId    String?
  location   String?
  occurredAt DateTime

  reportedById String
  assignedToId String?

  /// Hva ble gjort der og da for å stoppe skaden
  immediateAction  String?
  /// Hvorfor skjedde det — den egentlige årsaken, ikke den nærmeste
  rootCause        String?
  /// Hva gjør vi for at det ikke skal skje igjen
  correctiveAction String?
  deadline         DateTime?
  closedAt         DateTime?

  /// Arbeidsordren som ble opprettet for å rette avviket
  workOrderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reportedBy   User         @relation("AvvikMelder", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo   User?        @relation("AvvikAnsvarlig", fields: [assignedToId], references: [id], onDelete: SetNull)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  attachments Attachment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, assetId])
  @@index([organizationId, occurredAt])
  @@map("deviations")
}

model Dashboard {
  id             String   @id @default(cuid())
  organizationId String
  /// Null = delt dashbord for hele organisasjonen
  userId         String?
  name           String
  isDefault      Boolean  @default(false)
  /// [{ id, type, w, config }] — se src/lib/dashboard/widgets.ts
  layout         Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares       DashboardShare[]

  @@index([organizationId, userId])
  @@map("dashboards")
}

// ─────────────────────────────────────────────────────────────
// Chatbot
// ─────────────────────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @default("Ny samtale")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([organizationId, userId, updatedAt])
  @@map("conversations")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  /// Arbeidsordre og kilder svaret bygger på, vises som klikkbare referanser
  citations      Json     @default("[]")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────────────────────
// Felles
// ─────────────────────────────────────────────────────────────

model Comment {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String
  userId         String
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, workOrderId, createdAt])
  @@map("comments")
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  workOrderId    String?
  assetId        String?
  deviationId    String?
  uploadedById   String?
  fileName       String
  /// Nøkkelen hos lagringstjenesten. Se src/lib/lagring.ts.
  storagePath    String
  /// Adressen filen kan hentes fra
  url            String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviation    Deviation?   @relation(fields: [deviationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, workOrderId])
  @@index([organizationId, assetId])
  @@index([organizationId, deviationId])
  @@map("attachments")
}

/// Løpenummer per organisasjon. Oppdateres med en atomisk UPDATE ... RETURNING
/// slik at to samtidige arbeidsordrer aldri får samme nummer.
model Counter {
  organizationId String
  name           String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, name])
  @@map("counters")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  changes        Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
